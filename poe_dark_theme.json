{
  "name": "PoE Dark Executive v2",
  "dataColors": [
    "#E5B83B",
    "#6366F1",
    "#06B6D4",
    "#10B981",
    "#EF4444",
    "#F97316",
    "#8B5CF6",
    "#38BDF8",
    "#EC4899",
    "#A855F7"
  ],
  "background": "#14161D",
  "foreground": "#1E222D",
  "tableAccent": "#E5B83B",
  "good": "#10B981",
  "neutral": "#F59E0B",
  "bad": "#EF4444",
  "maximum": "#10B981",
  "center": "#F59E0B",
  "minimum": "#EF4444",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "title": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#F8FAFC"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#E2E8F0"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#94A3B8"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#1E222D" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A2F3D" } },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "foreground": { "solid": { "color": "#94A3B8" } },
            "background": { "solid": { "color": "#1E222D" } }
          }
        ],
        "outspacePane": [
          {
            "backgroundColor": { "solid": { "color": "#14161D" } },
            "foregroundColor": { "solid": { "color": "#F8FAFC" } }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#14161D" } },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "value": [
          {
            "color": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 22
          }
        ],
        "label": [
          {
            "color": { "solid": { "color": "#94A3B8" } },
            "fontSize": 10
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "general": [
          {
            "outlineColor": { "solid": { "color": "#2A2F3D" } },
            "outlineWeight": 1
          }
        ],
        "header": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#E2E8F0" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "background": { "solid": { "color": "#222734" } },
            "fontSize": 10
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "backColor": { "solid": { "color": "#252B3B" } },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "rowHeaders": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "backColor": { "solid": { "color": "#252B3B" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "values": [
          {
            "fontColorPrimary": { "solid": { "color": "#F8FAFC" } },
            "backColorPrimary": { "solid": { "color": "#1E222D" } },
            "fontColorSecondary": { "solid": { "color": "#F8FAFC" } },
            "backColorSecondary": { "solid": { "color": "#1E222D" } },
            "fontSize": 10
          }
        ],
        "grid": [
          {
            "gridVertical": true,
            "gridVerticalColor": { "solid": { "color": "#2A2F3D" } },
            "gridHorizontal": true,
            "gridHorizontalColor": { "solid": { "color": "#2A2F3D" } }
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "text": [
          {
            "fontColor": { "solid": { "color": "#F8FAFC" } },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "fill": [
          {
            "show": true,
            "fillColor": { "solid": { "color": "#222734" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#2A2F3D" } },
            "radius": 6
          }
        ]
      }
    }
  }
}
